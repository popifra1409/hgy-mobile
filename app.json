{
  "expo": {
    "name": "HGY — Hôpital Général de Yaoundé",
    "slug": "hgy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3D6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cm.hgy.mobile"
    },
    "android": {
      "package": "cm.hgy.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3D6E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://hopitalgeneraldeyaounde.cm/portail/public/api/v1",
      "wpUrl": "https://hopitalgeneraldeyaounde.cm/wpblog/wp-json/hgy/v1",
      "eas": {
        "projectId": "83b08f54-1681-406c-bf62-9d29712e7c54"
      }
    },
    "owner": "popifra1409"
  }
}