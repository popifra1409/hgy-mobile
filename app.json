{
  "expo": {
    "name": "HGY — Hôpital Général de Yaoundé",
    "slug": "hgy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3D6E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hgy.cm"
    },
    "android": {
      "package": "hgy.cm",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3D6E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://hopitalgeneraldeyaounde.cm/portail/public/api/v1",
      "wpUrl": "https://hopitalgeneraldeyaounde.cm/wpblog/wp-json/hgy/v1",
      "eas": {
        "projectId": "f5339b6e-0a6f-4864-9315-7d873a7ee9d9"
      }
    },
    "owner": "csishgy"
  }
}
